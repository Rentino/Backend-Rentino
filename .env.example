# ---------------------------------------------------------------------------
# Rentino backend — copy this file to `.env` before running the API.
#
#   cp .env.example .env
#
# Every value below is read at boot. `.env` is git-ignored on purpose; never
# commit real secrets.
# ---------------------------------------------------------------------------

# --- database --------------------------------------------------------------
# Development database. `docker compose up -d` starts a matching PostgreSQL 17
# container with user/password/database all set to `rentino`.
DATABASE_URL=postgresql://rentino:rentino@localhost:5432/rentino?schema=public

# Separate database used only by `npm run test:e2e`. The suite wipes every
# table before it runs, so it must NEVER point at the dev database.
TEST_DATABASE_URL=postgresql://rentino:rentino@localhost:5432/rentino_test?schema=public

# --- http ------------------------------------------------------------------
# Port the API listens on. All routes are served under /api/v1.
PORT=8000

NODE_ENV=development

# Comma-separated list of allowed frontend origins (no trailing slash).
CORS_ORIGINS=http://localhost:3000

# Where the simulated payment gateway redirects the user back to.
FRONTEND_URL=http://localhost:3000

# Public base URL of this API. Used to build the mock-gateway link, so it must
# be reachable from the browser (not from inside the container).
API_PUBLIC_URL=http://localhost:8000

# Set to `false` to disable the Swagger UI at /docs.
SWAGGER_ENABLED=true

# --- auth ------------------------------------------------------------------
# Token signing keys. Replace both in any real deployment:
#   openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars

# Token lifetimes. Access tokens are short-lived; refresh tokens rotate on use.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
